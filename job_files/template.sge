module purge
module load gcc/11.4.0
module load cuda/12.1
module load ffmpeg

source /data/scratch/anaconda3/bin/activate
conda activate hosem

CUDA_VISIBLE_DEVICES=0 python test_vis_2.py --ddp False -c /data/clusterfs/mld/users/lanliu/SIGGRAGH_2024/SemGesture/GestureLSM/configs/holisem_shortcut_rvqvae_test.yaml