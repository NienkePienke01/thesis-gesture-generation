{
    "project": "stage_2_model_training_loop_test",
    "device": "cuda",
    "gpus": [0, 1, 2, 3],
    "workers_per_gpu": 4,
    "periodic_backup_after_x_epochs": 10,
    "log_period": 1,

    "stage_1_pretrain": {
        "config_path": "configs/stage1_new_dyadit_model_attempt.json",
        "checkpoint_path": "checkpoints/stage1_new_dyadit_model_attempt/20260519_0207/model_final_epoch_799_val_loss_0.03552431985735893.bin"
    },

    "data": {
        "train_lmdb_": "cache/training_data/training_data_stage_2_full/training_data_stage_2_full_train",
        "val_lmdb_": "cache/training_data/training_data_stage_2_full/training_data_stage_2_full_val",
        "train_lmdb": "cache/training_data/training_data_stage_2_full/training_data_stage_2_full_train",
        "val_lmdb": "cache/training_data/training_data_stage_2_full/training_data_stage_2_full_val"
    },

    "model_params": {
        "d_model": 256,
        "nhead": 8,
        "num_layers": 2,
        "dim_feedforward": 1024,
        "dropout": 0.15,
        "max_seq_len": 64,
        "activation": "gelu",
        "n_tokens": 3,
        "audio_size": 1024,
        "audio_layers": 2,
        "bert_size": 768,
        "stage_1_layers": 4
    },

    "training_params": {
        "batch_size": 32,
        "epochs": 3,
        "lr_base": 0.0003,
        "warmup_epochs": 5,
        "decay_epochs": 150,
        "grad_norm": 1.0,
        "min_lr_ratio": 0.05,
        "max_mask_prob": 0.40,
        "cfg_drop_prob": 0.1,
        "soft_label_temperature": 0.05,
        "scheduled_sampling_prob": 0.5
    },

    "loss_weights": {
        "ce_weight": 1.0,
        "mse_weight": 100.0
    },

    "evaluation":{
        "test_folder": "data/seamless/downloads/test_set",
        "segmenter_config": "configs/seamless_segmenter_stage_2.json",
        "chunk_frames": [300, 900],
        "max_gb": 100,
        "eval_cmd_prefix": ["env", "-u", "PYTHONPATH", "-u", "PYTHONHOME", "uv", "run", "python", "-m", "evaluation.eval"],
        "infer_cmd_prefix": ["env", "-u", "PYTHONPATH", "-u", "PYTHONHOME", "uv", "run", "python", "-m", "evaluation.get_stage_2_results"],
        "infer_videos_prefix": ["env", "-u", "PYTHONPATH", "-u", "PYTHONHOME", "uv", "run", "python", "-m", "evaluation.render_qualitative_videos"]
    }
}