{
    "project": "seamless_stage1_training_upper_body",
    "mode": "upper_body",
    "device": "cuda",
    "gpus": [0],
    "vae_test_dim": 78,
    "periodic_backup_after_x_epochs": 50,
    "log_period": 1,

    "data": {
        "train_lmdb": "cache/segmenter/experimenting",
        "val_lmdb": "cache/segmenter/validation_testing"
    },

    "model_params": {
        "nb_code": 256,
        "code_dim": 256,
        "output_emb_width": 256,
        "down_t": 2,
        "stride_t": 2,
        "width": 256,
        "depth": 3,
        "dilation_growth_rate": 3,
        "activation": "relu"
    },

    "training_params": {
        "batch_size": 64,
        "epochs": 2,
        "lr_base": 0.0003,
        "decay_epochs": 9999,
        "grad_norm": 1.0
    },

    "loss_weights": {
        "rec_weight": 1,
        "ver_weight": 1,
        "vel_weight": 1,
        "acc_weight": 1,
        "commit_weight": 1
    }
}