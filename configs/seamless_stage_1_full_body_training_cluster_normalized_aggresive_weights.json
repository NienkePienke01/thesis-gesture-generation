{
    "project": "seamless_stage1_training_full_body_weight_test",
    "mode": "full",
    "device": "cuda",
    "gpus": [0, 1, 2, 3],
    "vae_test_dim": 258,
    "periodic_backup_after_x_epochs": 50,
    "log_period": 10,
    "normalize": true,

    "data": {
        "train_lmdb": "cache/segmenter/training_data_stage_1/training_data_stage_1_train",
        "val_lmdb": "cache/segmenter/training_data_stage_1/training_data_stage_1_val"
    },

    "model_params": {
        "nb_code": 512,
        "code_dim": 64,
        "output_emb_width": 64,
        "down_t": 2,
        "stride_t": 2,
        "width": 512,
        "depth": 3,
        "dilation_growth_rate": 3,
        "activation": "leaky_relu"
    },

    "training_params": {
        "batch_size": 64,
        "epochs": 800,
        "lr_base": 0.0002,
        "decay_epochs": 750,
        "grad_norm": 1.0
    },

    "loss_weights": {
        "rec_weight": 1,
        "ver_weight": 2,
        "vel_weight": 10,
        "acc_weight": 5,
        "commit_weight": 0.05
    }
}