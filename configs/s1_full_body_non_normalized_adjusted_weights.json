{
    "project": "s1_fullbody_not_normalized_adjusted_weights",
    "mode": "full",
    "device": "cuda",
    "gpus": [0, 1, 2, 3],
    "vae_test_dim": 258,
    "periodic_backup_after_x_epochs": 50,
    "log_period": 10,
    "normalize": false,

    "data": {
        "train_lmdb": "cache/training_data/training_data_filtered/training_data_filtered_train",
        "val_lmdb": "cache/training_data/training_data_filtered/training_data_filtered_val"
    },

    "model_params": {
        "nb_code": 512,
        "code_dim": 64,
        "output_emb_width": 64,
        "down_t": 2,
        "stride_t": 2,
        "width": 512,
        "depth": 3,
        "dilation_growth_rate": 3,
        "activation": "leaky_relu"
    },

    "training_params": {
        "batch_size": 64,
        "epochs": 800,
        "lr_base": 0.0001,
        "decay_epochs": 750,
        "grad_norm": 1.0,
        "rec_mse": false
    },

    "loss_weights": {
        "rec_weight": 0.5,
        "ver_weight": 1,
        "vel_weight": 5,
        "acc_weight": 10,
        "commit_weight": 0.05
    }
}